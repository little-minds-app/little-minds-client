{
  "$comment": "Minimum non-breaking contract surface for LMP-23/LMP-50/LMP-37 (client). Paths outside allowlist fail (scope lock — no invented product APIs).",
  "contractVersionFile": "contracts/VERSION",
  "allowBreakingRemovalsFromMajor": 1,
  "allowedPaths": [
    "/health",
    "/health/ready",
    "/v1/auth/token/refresh",
    "/v1/auth/logout",
    "/v1/auth/logout-all",
    "/v1/auth/sessions",
    "/v1/auth/sessions/{sessionId}",
    "/v1/parent/me",
    "/v1/auth/phone/start",
    "/v1/auth/phone/verify",
    "/v1/auth/oidc/nonce",
    "/v1/auth/google/pkce/start",
    "/v1/auth/apple",
    "/v1/auth/google",
    "/v1/auth/email/start",
    "/v1/auth/email/verify",
    "/v1/auth/identities/step-up",
    "/v1/auth/identities/link",
    "/v1/auth/dev/session"
  ],
  "requiredOperations": [
    {
      "path": "/health",
      "method": "get",
      "operationId": "getHealth",
      "responseStatus": "200",
      "schemaRef": "#/components/schemas/HealthStatus",
      "requiredProperties": ["status", "service", "timestamp"]
    },
    {
      "path": "/v1/auth/phone/start",
      "method": "post",
      "operationId": "startPhoneOtp",
      "responseStatus": "200",
      "schemaRef": "#/components/schemas/PhoneOtpStartResponse",
      "requiredProperties": ["challenge_id", "expires_in", "resend_after"]
    },
    {
      "path": "/v1/auth/phone/verify",
      "method": "post",
      "operationId": "verifyPhoneOtp",
      "responseStatus": "200",
      "schemaRef": "#/components/schemas/TokenPairResponse",
      "requiredProperties": [
        "access_token",
        "refresh_token",
        "token_type",
        "expires_in",
        "session_id",
        "parent_id"
      ]
    },
    {
      "path": "/v1/auth/email/start",
      "method": "post",
      "operationId": "startEmailOtp",
      "responseStatus": "200",
      "schemaRef": "#/components/schemas/EmailOtpStartResponse",
      "requiredProperties": ["challenge_id", "expires_in", "resend_after"]
    },
    {
      "path": "/v1/auth/token/refresh",
      "method": "post",
      "operationId": "refreshParentSession",
      "responseStatus": "200",
      "schemaRef": "#/components/schemas/TokenPairResponse",
      "requiredProperties": [
        "access_token",
        "refresh_token",
        "token_type",
        "expires_in",
        "session_id",
        "parent_id"
      ]
    },
    {
      "path": "/v1/parent/me",
      "method": "get",
      "operationId": "getParentMe",
      "responseStatus": "200",
      "schemaRef": "#/components/schemas/ParentMeResponse",
      "requiredProperties": ["parent_id", "locale", "timezone", "lifecycle"]
    }
  ],
  "requiredSchemas": {
    "HealthStatus": {
      "required": ["status", "service", "timestamp"],
      "properties": {
        "status": { "enum": ["ok"] },
        "service": { "enum": ["little-minds-backend"] },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "ActivitySessionV1": {
      "required": [
        "schema_version",
        "play_session_id",
        "device_id",
        "content_version_id",
        "started_at",
        "completion_status",
        "consent",
        "provenance"
      ],
      "properties": {}
    },
    "ActivityEventV1": {
      "required": [
        "schema_version",
        "event_id",
        "event_type",
        "device_id",
        "content_version_id",
        "occurred_at",
        "consent_scope",
        "consent_policy_version",
        "provenance",
        "payload"
      ],
      "properties": {}
    },
    "TokenPairResponse": {
      "required": [
        "access_token",
        "refresh_token",
        "token_type",
        "expires_in",
        "session_id",
        "parent_id"
      ],
      "properties": {}
    },
    "AuthError": {
      "required": ["error", "message"],
      "properties": {
        "error": {
          "enum": [
            "invalid_request",
            "invalid_token",
            "expired_token",
            "revoked_session",
            "refresh_reuse",
            "rate_limited",
            "session_limit_exceeded",
            "bootstrap_disabled",
            "otp_invalid",
            "otp_cooldown",
            "sms_unavailable",
            "mail_unavailable",
            "identity_collision"
          ]
        }
      }
    }
  }
}
