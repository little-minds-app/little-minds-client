{
  "$comment": "Minimum non-breaking contract surface. Paths outside allowlist fail. LMP-33 parent auth + LMP-34 GSM OTP + LMP-35 multi-provider + LMP-36 linking. LMP-50 Activity* schemas remain components-only. LMP-38 backend-owned opaque web sessions. LMP-39 parent-owned child profiles. LMP-40 child list/edit and web BFF profile APIs. LMP-52 canonical session KPIs. LMP-130 mission status read + caregiver feedback write.",
  "contractVersionFile": "contracts/VERSION",
  "allowBreakingRemovalsFromMajor": 1,
  "allowedPaths": [
    "/health",
    "/health/ready",
    "/v1/auth/token/refresh",
    "/v1/auth/logout",
    "/v1/auth/logout-all",
    "/v1/auth/sessions",
    "/v1/auth/sessions/{sessionId}",
    "/v1/parent/me",
    "/v1/parent/profile",
    "/v1/auth/web/profile",
    "/v1/auth/dev/session",
    "/v1/auth/phone/start",
    "/v1/auth/phone/verify",
    "/v1/auth/oidc/nonce",
    "/v1/auth/google/pkce/start",
    "/v1/auth/apple",
    "/v1/auth/google",
    "/v1/auth/email/start",
    "/v1/auth/email/verify",
    "/v1/auth/identities/step-up",
    "/v1/auth/identities/link",
    "/v1/auth/web/session",
    "/v1/auth/web/me",
    "/v1/auth/web/activity",
    "/v1/auth/web/logout",
    "/v1/children",
    "/v1/children/{childId}",
    "/v1/web/children",
    "/v1/web/children/{childId}",
    "/v1/web/insights/session-kpis",
    "/v1/web/children/{childId}/missions",
    "/v1/parent/gate/status",
    "/v1/parent/gate/proof",
    "/v1/parent/gate/setup",
    "/v1/parent/gate/reset",
    "/v1/parent/gate/verify",
    "/v1/parent/gate/grant",
    "/v1/events/batch",
    "/v1/insights/session-kpis",
    "/v1/children/{childId}/missions",
    "/v1/children/{childId}/missions/{missionId}/feedback"
  ],
  "requiredOperations": [
    {
      "path": "/health",
      "method": "get",
      "operationId": "getHealth",
      "responseStatus": "200",
      "schemaRef": "#/components/schemas/HealthStatus",
      "requiredProperties": [
        "status",
        "service",
        "timestamp"
      ]
    },
    {
      "path": "/health/ready",
      "method": "get",
      "operationId": "getHealthReady",
      "responseStatus": "200",
      "schemaRef": "#/components/schemas/ReadinessStatus",
      "requiredProperties": [
        "status",
        "service",
        "timestamp",
        "checks"
      ]
    },
    {
      "path": "/v1/auth/token/refresh",
      "method": "post",
      "operationId": "refreshParentSession",
      "responseStatus": "200",
      "schemaRef": "#/components/schemas/TokenPairResponse",
      "requiredProperties": [
        "access_token",
        "refresh_token",
        "token_type",
        "expires_in",
        "session_id",
        "parent_id"
      ]
    },
    {
      "path": "/v1/parent/me",
      "method": "get",
      "operationId": "getParentMe",
      "responseStatus": "200",
      "schemaRef": "#/components/schemas/ParentMeResponse",
      "requiredProperties": [
        "parent_id",
        "locale",
        "timezone",
        "lifecycle"
      ]
    }
  ],
  "requiredSchemas": {
    "HealthStatus": {
      "required": [
        "status",
        "service",
        "timestamp"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok"
          ]
        },
        "service": {
          "enum": [
            "little-minds-backend"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ReadinessStatus": {
      "required": [
        "status",
        "service",
        "timestamp",
        "checks"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "not_ready"
          ]
        },
        "service": {
          "enum": [
            "little-minds-backend"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "TokenPairResponse": {
      "required": [
        "access_token",
        "refresh_token",
        "token_type",
        "expires_in",
        "session_id",
        "parent_id"
      ],
      "properties": {}
    },
    "ParentMeResponse": {
      "required": [
        "parent_id",
        "locale",
        "timezone",
        "lifecycle"
      ],
      "properties": {}
    },
    "ActivitySessionV1": {
      "required": [
        "schema_version",
        "play_session_id",
        "device_id",
        "content_version_id",
        "started_at",
        "completion_status",
        "consent",
        "provenance"
      ],
      "properties": {}
    },
    "ActivityEventV1": {
      "required": [
        "schema_version",
        "event_id",
        "event_type",
        "device_id",
        "content_version_id",
        "occurred_at",
        "consent_scope",
        "consent_policy_version",
        "provenance",
        "payload"
      ],
      "properties": {}
    }
  }
}
